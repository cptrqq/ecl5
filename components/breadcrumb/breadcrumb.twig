{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set classes = ['ecl-breadcrumb', extra_classes]|filter(c => c)|join(' ') -%}
  <nav class="{{ classes }}" aria-label="{{ aria_label|default('You are here:') }}" data-ecl-auto-init="Breadcrumb">
    <ol class="ecl-breadcrumb__container">
      {%- for link in links|default([]) -%}
        {%- if loop.last -%}
          <li class="ecl-breadcrumb__segment ecl-breadcrumb__current-page" data-ecl-breadcrumb-item="static" aria-current="page">{{ link.label }}</li>
        {%- else -%}
          <li class="ecl-breadcrumb__segment" data-ecl-breadcrumb-item="static">
            {{ include('ecl5:link', { label: link.label, path: link.path|default('#'), variant: 'standalone', extra_classes: 'ecl-breadcrumb__link' }) }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </nav>
{%- endapply -%}
