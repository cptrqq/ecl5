{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set id = id|default('carousel') -%}
  {%- set classes = ['ecl-carousel', full_width ? 'ecl-carousel--full-width', extra_classes]|filter(c => c)|join(' ') -%}
  <section class="{{ classes }}" id="{{ id }}" data-ecl-auto-init="Carousel" data-ecl-carousel-counter-label="{{ counter_label|default('of')|e('html_attr') }}">
    <div class="ecl-carousel__controls">
      <div class="ecl-container">
        <div class="ecl-carousel__navigation">
          <div class="ecl-carousel__pager-container">
            <div class="ecl-carousel__pager">
              <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-carousel__prev">
                <span class="ecl-button__label" aria-hidden="true">{{ sr_previous|default('Previous') }}</span>
                {{ include('ecl5:icon', { name: 'caret-left', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
              </button>
              <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-carousel__play">
                <span class="ecl-button__label" aria-hidden="true">{{ sr_play|default('Play') }}</span>
                {{ include('ecl5:icon', { name: 'play-circle', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
              </button>
              <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-carousel__pause">
                <span class="ecl-button__label" aria-hidden="true">{{ sr_pause|default('Pause') }}</span>
                {{ include('ecl5:icon', { name: 'pause-circle', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
              </button>
              <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-carousel__next">
                <span class="ecl-button__label" aria-hidden="true">{{ sr_next|default('Next') }}</span>
                {{ include('ecl5:icon', { name: 'caret-right', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
              </button>
            </div>
            <div class="ecl-carousel__counter" dir="ltr"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="ecl-carousel__viewport">
      <div class="ecl-carousel__slides">
        {%- for item in items|default([]) -%}
          <div class="ecl-carousel__slide" data-ecl-carousel-slide-index="{{ loop.index0 }}">
            {{ include('ecl5:banner', item, false) }}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endapply -%}
