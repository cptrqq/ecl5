{{ attach_library('ecl5/global') }}
{%- import _self as cf -%}
{%- apply spaceless -%}
  {%- set id = id|default('ecl-category-filter-' ~ random()) -%}
  {%- set classes = ['ecl-category-filter', extra_classes]|filter(c => c)|join(' ') -%}
  <nav class="{{ classes }}" data-ecl-category-filter data-ecl-auto-init="CategoryFilter"
    {%- if label is defined and label is not empty %} aria-label="{{ label }}"{% endif -%}
  >
    <ul class="ecl-category-filter__list">
      {%- if items is defined and items is not empty -%}
        {{ cf.items(items, id, 1) }}
      {%- endif -%}
    </ul>
  </nav>
{%- endapply -%}

{%- macro items(items, id, level) -%}
  {%- import _self as cf -%}
  {%- apply spaceless -%}
    {%- for item in items -%}
      {%- set item_id = id ~ '-' ~ loop.index -%}
      {%- set has_children = item.children is defined and item.children is not empty -%}
      {%- set item_class = 'ecl-category-filter__item ecl-category-filter__item--level-' ~ level ~ (has_children ? ' ecl-category-filter__item--has-children' : '') -%}
      <li class="ecl-category-filter__list-item">
        {%- if has_children -%}
          <button class="{{ item_class }}" aria-expanded="false" aria-controls="{{ item_id }}"
            {%- if item.current %} aria-current="true"{% endif -%}
          >
            {%- if level != 1 -%}
              {{ include('ecl5:icon', { name: 'caret-right', family: 'phosphor', size: 'xs', extra_classes: 'ecl-category-filter__item-icon' }, false) }}
            {%- endif -%}
            {{- item.label -}}
            {%- if level == 1 -%}
              {{ include('ecl5:icon', { name: 'caret-down', family: 'phosphor', size: 'xs', extra_classes: 'ecl-category-filter__item-icon' }, false) }}
            {%- endif -%}
          </button>
          <ul class="ecl-category-filter__list" id="{{ item_id }}">
            {{ cf.items(item.children, item_id, level + 1) }}
          </ul>
        {%- else -%}
          <a href="{{ item.path }}" class="{{ item_class }}"
            {%- if item.current %} aria-current="true"{% endif -%}
          >{{- item.label -}}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endapply -%}
{%- endmacro -%}
