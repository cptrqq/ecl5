{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- for item in items|default([]) -%}
    {%- set classes = ['ecl-checkbox', loop.first and extra_classes ? extra_classes]|filter(c => c)|join(' ') -%}
    <div class="{{ classes }}">
      <input name="{{ name }}" class="ecl-checkbox__input" type="checkbox" value="{{ item.value|default('') }}"
        {{- item.id ? ' id="' ~ item.id|e('html_attr') ~ '"' -}}
        {{- item.disabled ? ' disabled' -}}
        {{- item.checked ? ' checked' -}}
        {{- item.required ? ' required' -}}>
      <label{{ item.id ? ' for="' ~ item.id|e('html_attr') ~ '"' : '' }} class="ecl-checkbox__label">
        <span class="ecl-checkbox__box">
          {{ include('ecl5:icon', { name: 'check', family: 'phosphor', size: 'xs', extra_classes: 'ecl-checkbox__icon' }, false) }}
        </span>
        {%- if item.label -%}<span class="ecl-checkbox__text">{{ item.label }}</span>{%- endif -%}
      </label>
    </div>
  {%- endfor -%}
{%- endapply -%}
