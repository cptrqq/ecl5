{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {#
    ECL icon. ECL v5 uses Phosphor icons. Glyphs come from the bundled sprite
    assets/icons/phosphor.svg (full regular + fill weights), referenced with
    <use>. The sprite URL is resolved by the ecl5_icon_sprite() Twig function
    (see src/Twig/IconExtension.php); pass `icon_path` to override it.
  #}
  {%- set size = size|default('m') -%}
  {%- set family = family|default('phosphor') -%}
  {%- set _aliases = { 'home': 'house', 'close': 'x' } -%}
  {%- set _key = _aliases[name]|default(name) -%}
  {%- set _sprite = icon_path|default(ecl5_icon_sprite()) -%}
  {%- set classes = [
    'ecl-icon',
    size ? 'ecl-icon--' ~ size,
    transform ? 'ecl-icon--' ~ transform,
    color ? 'ecl-icon--' ~ color,
    (family and name) ? 'ecl-icon-' ~ family ~ '--' ~ name,
    extra_classes,
  ]|filter(c => c)|join(' ') -%}
  <svg class="{{ classes }}" viewBox="0 0 256 256" fill="currentColor" focusable="false"
    aria-hidden="{{ title ? 'false' : 'true' }}"{{ title ? ' role="img"' : '' }}>
    {%- if title %}<title>{{ title }}</title>{% endif -%}
    <use xlink:href="{{ _sprite }}#{{ _key }}" href="{{ _sprite }}#{{ _key }}"></use>
  </svg>
{%- endapply -%}
