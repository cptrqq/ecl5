{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set id = id|default('ecl-menu-item') -%}
  {%- set label = label|default('') -%}
  {%- set has_children = children is defined and children|default([])|length > 0 -%}
  {%- set item_class = [
    'ecl-menu__item',
    is_current ? 'ecl-menu__item--current',
    has_children ? 'ecl-menu__item--has-children',
    extra_classes,
  ]|filter(c => c)|join(' ') -%}
  {%- set link_attributes = [
    { name: 'data-ecl-menu-link' },
    { name: 'id', value: id ~ '-link' },
  ] -%}
  {%- if is_current -%}
    {%- set link_attributes = link_attributes|merge([{ name: 'aria-current', value: 'page' }]) -%}
  {%- endif -%}
  <li class="{{ item_class }}" data-ecl-menu-item{{ has_children ? ' data-ecl-has-children data-expanded="false"' }} id="{{ id }}">
    {{ include('ecl5:link', {
      label: label,
      path: path|default('#'),
      external: external|default(false),
      extra_classes: 'ecl-menu__link' ~ (is_current ? ' ecl-menu__link--current' : ''),
      extra_attributes: link_attributes,
    }, false) }}
    {%- if has_children -%}
      {{ include('ecl5:button', {
        type: 'button',
        variant: 'tertiary',
        style: 'neutral',
        icon: { name: 'caret-down', family: 'phosphor', size: 'xs' },
        extra_classes: 'ecl-menu__button-caret',
        extra_attributes: [
          { name: 'data-ecl-menu-caret' },
          { name: 'aria-haspopup', value: 'true' },
          { name: 'aria-expanded', value: 'false' },
          { name: 'aria-label', value: trigger_aria_label|default(label) },
        ],
      }, false) }}
      <div class="ecl-menu__mega" data-ecl-menu-mega>
        <ul class="ecl-menu__sublist">
          {%- for child in children -%}
            <li class="ecl-menu__subitem{{ child.is_current ? ' ecl-menu__subitem--current' }}" data-ecl-menu-subitem>
              {{ include('ecl5:link', {
                label: child.label,
                path: child.path|default('#'),
                external: child.external|default(false),
                extra_classes: 'ecl-menu__sublink' ~ (child.is_current ? ' ecl-menu__sublink--current' : ''),
                extra_attributes: child.is_current ? [{ name: 'aria-current', value: 'page' }] : [],
              }, false) }}
            </li>
          {%- endfor -%}
          {%- if see_all_label|default('') -%}
            <li class="ecl-menu__subitem ecl-menu__see-all">
              {{ include('ecl5:link', {
                label: see_all_label,
                path: path|default('#'),
                icon: { name: 'arrow-right', family: 'phosphor', size: 'xs' },
                extra_classes: 'ecl-menu__sublink',
              }, false) }}
            </li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </li>
{%- endapply -%}
