{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set id = id|default('ecl-menu-item') -%}
  {%- set has_children = children is defined and children|default([])|length > 0 -%}
  {%- set item_class = [
    'ecl-menu__item',
    is_current ? 'ecl-menu__item--current',
    has_children ? 'ecl-menu__item--has-children',
    extra_classes,
  ]|filter(c => c)|join(' ') -%}
  <li class="{{ item_class }}" data-ecl-menu-item id="{{ id }}">
    <a href="{{ path|default('#') }}" class="ecl-menu__link{{ is_current ? ' ecl-menu__link--current' }}" data-ecl-menu-link{{ is_current ? ' aria-current="page"' }}>
      <span class="ecl-menu__link-label">{{ label }}</span>
    </a>
    {%- if has_children -%}
      <button type="button" class="ecl-button ecl-button--tertiary ecl-menu__caret-button ecl-button--icon-only" data-ecl-menu-caret aria-expanded="false">
        <span class="ecl-button__label" aria-hidden="true">{{ label }}</span>
        {{ include('ecl5:icon', { name: 'caret-down', family: 'phosphor', size: 's', extra_classes: 'ecl-button__icon' }, false) }}
      </button>
      <div class="ecl-menu__mega" data-ecl-menu-mega>
        <ul class="ecl-menu__sublist">
          {%- for child in children -%}
            <li class="ecl-menu__subitem{{ child.is_current ? ' ecl-menu__subitem--current' }}" data-ecl-menu-subitem>
              <a href="{{ child.path|default('#') }}" class="ecl-menu__sublink"{{ child.is_current ? ' aria-current="page"' }}>{{ child.label }}</a>
            </li>
          {%- endfor -%}
          <li class="ecl-menu__subitem ecl-menu__see-all">
            <a href="{{ path|default('#') }}" class="ecl-menu__sublink">{{ see_all_label|default('See all') }}</a>
          </li>
        </ul>
      </div>
    {%- endif -%}
  </li>
{%- endapply -%}
