{% stories modal with { title: 'ECL/Content/Modal' } %}

  {% story default with { name: 'Default' } %}
    {{ include('ecl5:button', { label: 'Open modal', variant: 'primary', type: 'button', extra_attributes: [{ name: 'data-ecl-modal-toggle', value: 'demo-modal' }] }) }}
    {% embed 'ecl5:modal' with { id: 'demo-modal', header: 'Confirm action', close_label: 'Close', buttons: [ { label: 'Confirm', variant: 'primary' }, { label: 'Cancel', variant: 'secondary' } ] } %}
      {% block body %}<p>Are you sure you want to continue?</p>{% endblock %}
    {% endembed %}
  {% endstory %}

{% endstories %}
