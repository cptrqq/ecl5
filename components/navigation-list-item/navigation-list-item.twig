{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set classes = ['ecl-navigation-list__item', border ? 'ecl-navigation-list__item--border', extra_classes]|filter(c => c)|join(' ') -%}
  <article class="{{ classes }}">
    {%- if picture.img is defined and picture.img -%}
      {{ include('ecl5:picture', picture|merge({ extra_classes: 'ecl-navigation-list__picture', extra_image_classes: 'ecl-navigation-list__image' }), false) }}
    {%- endif -%}
    {%- set cb_props = {
      description: description|default(''),
      primary_meta: primary_meta|default([]),
      links: links|default([]),
      extra_classes: 'ecl-navigation-list__content-block',
    } -%}
    {%- if title is not empty -%}
      {%- set cb_props = cb_props|merge({ title: title }) -%}
    {%- endif -%}
    {{ include('ecl5:content-block', cb_props, false) }}
  </article>
{%- endapply -%}
