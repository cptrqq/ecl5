{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set classes = ['ecl-pagination', extra_classes]|filter(c => c)|join(' ') -%}
  <nav class="{{ classes }}" aria-label="{{ label|default('Pagination') }}">
    <ul class="ecl-pagination__list">
      {%- for item in items|default([]) -%}
        <li class="ecl-pagination__item{{ item.type ? ' ecl-pagination__item--' ~ item.type }}">
          {%- if item.type == 'current' -%}
            <span class="ecl-pagination__text ecl-pagination__text--summary" aria-current="true">{{ item.label|default('') }}</span>
          {%- elseif item.path is defined and item.path -%}
            {%- set icon = {} -%}
            {%- if item.type == 'previous' -%}{%- set icon = { name: 'arrow-left', family: 'phosphor', size: 'xs' } -%}
            {%- elseif item.type == 'next' -%}{%- set icon = { name: 'arrow-right', family: 'phosphor', size: 'xs' } -%}{%- endif -%}
            {%- set link_props = {
              label: item.label|default(''),
              path: item.path,
              variant: 'standalone',
              icon: icon,
              icon_position: item.type == 'previous' ? 'before' : 'after',
              extra_classes: 'ecl-pagination__link',
            } -%}
            {%- if item.type == 'previous' or item.type == 'next' -%}
              {%- set link_props = link_props|merge({ hide_label: true }) -%}
            {%- endif -%}
            {%- if item.aria_label is defined and item.aria_label is not empty -%}
              {%- set link_props = link_props|merge({ aria_label: item.aria_label }) -%}
            {%- endif -%}
            {{ include('ecl5:link', link_props, false) }}
          {%- else -%}
            <span class="ecl-pagination__text ecl-pagination__text--summary">{{ item.type == 'ellipsis' ? '…' : item.label|default('') }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endapply -%}
