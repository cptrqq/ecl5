{{ attach_library('ecl5/global') }}
{%- import _self as quiz -%}
{%- apply spaceless -%}
  {%- set id = id|default('ecl-quiz-' ~ random()) -%}
  {%- set variant = variant|default('reveal') -%}
  {%- set items = items|default([]) -%}
  {%- set skip_text = skip_text|default('Use ESC to skip the quiz') -%}
  {%- set with_background = with_background|default(false) -%}
  {%- set full_width = full_width|default(false) -%}
  {%- set classes = [
    'ecl-quiz',
    'ecl-quiz--' ~ variant,
    (with_background or full_width) ? 'ecl-quiz--background',
    full_width ? 'ecl-quiz--full-width',
    extra_classes,
  ]|filter(c => c)|join(' ') -%}

  <section class="{{ classes }}" id="{{ id }}" data-ecl-auto-init="Quiz">
    {%- if full_width -%}<div class="ecl-container">{%- endif -%}
    {%- if title is not empty or description is not empty -%}
      <div class="ecl-quiz__header">
        {%- if title is not empty -%}<div class="ecl-quiz__title">{{- title -}}</div>{%- endif -%}
        {%- if description is not empty -%}<div class="ecl-quiz__description">{{- description -}}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if items is not empty -%}
      <div class="ecl-quiz__viewport" data-ecl-quiz-slider>
        <ol class="ecl-quiz__list">
          {%- for item in items -%}
            {{ quiz.card(item, variant, id ~ '-' ~ loop.index, loop.first ? skip_text : '') }}
          {%- endfor -%}
        </ol>
      </div>
      <div class="ecl-slider-pager ecl-quiz__pager">
        {{ include('ecl5:button', {
          type: 'button', variant: 'tertiary', style: 'neutral', size: 's',
          label: prev_label|default(''), hide_label: true,
          icon: { name: 'caret-left', family: 'phosphor' },
          extra_classes: 'ecl-slider-pager__prev ecl-quiz__prev',
        }, false) }}
        <div class="ecl-slider-pager__dots ecl-quiz__dots"></div>
        {{ include('ecl5:button', {
          type: 'button', variant: 'tertiary', style: 'neutral', size: 's',
          label: next_label|default(''), hide_label: true,
          icon: { name: 'caret-right', family: 'phosphor' },
          extra_classes: 'ecl-slider-pager__next ecl-quiz__next',
        }, false) }}
        <script type="text/template" data-ecl-slider-dot-template data-ecl-quiz-dot-template>
          <button class="ecl-slider-pager__dot ecl-quiz__dot"></button>
        </script>
      </div>
      <div class="ecl-quiz__counter" dir="ltr"></div>
    {%- endif -%}
    {%- if full_width -%}</div>{%- endif -%}
  </section>
{%- endapply -%}

{%- macro card(item, variant, id, esc_box) -%}
  {%- apply spaceless -%}
    {%- set image_display = item.image_display|default('') -%}
    {%- set picture = item.picture|default({}) -%}
    {%- set icon = item.icon|default({}) -%}
    {%- set back_icon = item.back_icon|default({}) -%}
    {%- set flip_icon = item.flip_icon|default({}) -%}
    {%- set options = item.options|default([]) -%}
    {%- set name = item.name|default(id ~ '-options') -%}
    {%- set has_picture = picture.img is defined and picture.img.src is defined and picture.img.src -%}
    {%- set picture_markup -%}
      {%- if has_picture -%}
        {{ include('ecl5:picture', picture|merge({ extra_classes: 'ecl-quiz-card__picture', extra_image_classes: 'ecl-quiz-card__image' }), false) }}
      {%- endif -%}
    {%- endset -%}
    {%- set card_attrs = [] -%}
    {%- if item.correct_chosen_label is defined and item.correct_chosen_label is not empty -%}
      {%- set card_attrs = card_attrs|merge([{ name: 'data-ecl-quiz-chosen-option-correct', value: item.correct_chosen_label }]) -%}
    {%- endif -%}
    {%- if item.incorrect_chosen_label is defined and item.incorrect_chosen_label is not empty -%}
      {%- set card_attrs = card_attrs|merge([{ name: 'data-ecl-quiz-chosen-option-incorrect', value: item.incorrect_chosen_label }]) -%}
    {%- endif -%}
    {%- set card_classes = ['ecl-quiz-card', item.extra_classes|default('')]|filter(c => c)|join(' ') -%}

    <li class="{{ card_classes }}" id="{{ id }}"
      {%- for attr in card_attrs %} {{ attr.name }}="{{ attr.value|e('html_attr') }}"{% endfor -%}
      {{- variant == 'reveal' ? ' tabindex="0" data-ecl-quiz-card-flip' : '' -}}>
      <article class="ecl-quiz-card__content">
        <div class="ecl-quiz-card__front">
          {%- if image_display == 'always' -%}
            {{ picture_markup }}
          {%- elseif variant == 'poll' and image_display == 'reveal' -%}
            <div class="ecl-quiz-card__illustration-container">
              <svg viewBox="0 0 500 140" preserveAspectRatio="none" aria-hidden="true" class="ecl-quiz-card__illustration">
                <defs>
                  <g id="question-mark">
                    <path d="M0 0c0 4.343-3.728 7.939-8.531 8.464V9.75a1.22 1.22 0 0 1-2.438 0V7.313a1.22 1.22 0 0 1 1.219-1.22c4.033 0 7.312-2.732 7.312-6.093s-3.279-6.094-7.312-6.094-7.312 2.733-7.312 6.094a1.22 1.22 0 0 1-2.438 0c0-4.704 4.374-8.531 9.75-8.531S0-4.704 0 0Zm-9.75 14.625a2.438 2.438 0 1 0 0 4.875 2.438 2.438 0 0 0 0-4.875Z"/>
                  </g>
                </defs>
                {%- for i in 1..18 -%}<use href="#question-mark" class="qm qm-{{ i }}"/>{%- endfor -%}
              </svg>
            </div>
          {%- endif -%}
          <div class="ecl-quiz-card__padded">
            <div class="ecl-quiz-card__header">
              {%- if icon is not empty and not (variant == 'poll' and image_display == 'reveal') -%}
                <div class="ecl-quiz-card__icon">{{ include('ecl5:icon', icon, false) }}</div>
              {%- endif -%}
            </div>
            {%- if variant == 'reveal' -%}
              <div class="ecl-quiz-card__question" id="{{ id }}-question">{{- item.question -}}</div>
            {%- endif -%}
            {%- if options is not empty -%}
              <fieldset{% if esc_box is not empty %} aria-describedby="quiz-{{ id }}-skip-instructions"{% endif %}>
                <legend class="ecl-quiz-card__question" id="{{ id }}-question">{{- item.question -}}</legend>
                <ol class="ecl-quiz-card__options" type="A">
                  {%- for option in options -%}
                    <li class="ecl-quiz-card__option">
                      <label class="ecl-quiz-card__label">
                        <input type="radio" data-ecl-quiz-card-flip data-ecl-quiz-card-input name="{{ name }}" data-match="{{ option.correct ? 'true' : 'false' }}">
                        {{- option.name -}}
                      </label>
                      {%- if loop.first and esc_box is not empty -%}
                        <span class="ecl-quiz__skip" id="quiz-{{ id }}-skip-instructions">{{- esc_box -}}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ol>
              </fieldset>
            {%- endif -%}
            {%- if item.flip_text is defined and item.flip_text is not empty -%}
              <div class="ecl-quiz-card__flip">{{- item.flip_text -}}{{ include('ecl5:icon', flip_icon, false) }}</div>
            {%- endif -%}
          </div>
        </div>
        <div class="ecl-quiz-card__back" hidden inert>
          {{ picture_markup }}
          <div class="ecl-quiz-card__padded">
            <div class="ecl-quiz-card__header">
              {%- if icon is not empty or back_icon is not empty -%}
                <div class="ecl-quiz-card__icon">
                  {%- if back_icon is not empty -%}
                    {{ include('ecl5:icon', back_icon.success|merge({ extra_classes: 'ecl-quiz-card__icon--success' }), false) }}
                    {%- set icon = back_icon.error -%}
                  {%- endif -%}
                  {%- if icon is not empty -%}{{ include('ecl5:icon', icon, false) }}{%- endif -%}
                </div>
              {%- endif -%}
            </div>
            <div class="ecl-quiz-card__answer" id="{{ id }}-answer">
              <div class="ecl-quiz-card__answer-content">
                {%- if item.answer_title is defined and item.answer_title is not empty -%}
                  <div class="ecl-quiz-card__answer-title" tabindex="0">{{ item.answer_title }}</div>
                {%- endif -%}
                {{- item.answer -}}
              </div>
            </div>
            {%- if options is not empty -%}
              <ol class="ecl-quiz-card__options" type="A">
                {%- for option in options -%}
                  <li class="ecl-quiz-card__option" data-match="{{ option.correct ? 'true' : 'false' }}">
                    <span class="ecl-quiz-card__option-assistive-label">{{- option.correct ? item.correct_label|default('') : item.incorrect_label|default('') -}}</span>
                    {{- option.name -}}
                    <span class="ecl-quiz-card__option-icon">
                      {%- if option.correct -%}
                        {{ include('ecl5:icon', back_icon.success|merge({ size: 's', extra_classes: 'ecl-quiz-card__option-icon--success' }), false) }}
                      {%- else -%}
                        {{ include('ecl5:icon', back_icon.error|merge({ size: 's', extra_classes: 'ecl-quiz-card__option-icon--error' }), false) }}
                      {%- endif -%}
                    </span>
                  </li>
                {%- endfor -%}
              </ol>
            {%- endif -%}
            {%- if (item.back_text is defined and item.back_text is not empty) or flip_icon is not empty -%}
              <div class="ecl-quiz-card__flip">{{- item.back_text|default('') -}}{{ include('ecl5:icon', flip_icon, false) }}</div>
            {%- endif -%}
          </div>
        </div>
      </article>
    </li>
  {%- endapply -%}
{%- endmacro -%}
