{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set id = id|default('slogan-ticker') -%}
  {%- set autoplay = autoplay is defined ? autoplay : true -%}
  {%- set classes = ['ecl-slogan-ticker', extra_classes]|filter(c => c)|join(' ') -%}
  <div class="{{ classes }}" id="{{ id }}" data-ecl-slogan-ticker="true" data-ecl-auto-init="SloganTicker"{{ autoplay ? '' : ' data-ecl-slogan-ticker-autoplay="false"' }}>
    <div class="ecl-slogan-ticker__viewport" data-ecl-slogan-ticker-slider>
      <ul class="ecl-slogan-ticker__track">
        {%- for item in items|default([]) -%}
          <li class="ecl-slogan-ticker__slide">{{ item }}</li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="ecl-slogan-ticker__controls">
      <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-slogan-ticker__button ecl-slogan-ticker__play" data-ecl-slogan-ticker-play>
        <span class="ecl-button__label" aria-hidden="true">{{ sr_play|default('Play') }}</span>
        {{ include('ecl5:icon', { name: 'play-circle', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
      </button>
      <button type="button" class="ecl-button ecl-button--tertiary ecl-button--icon-only ecl-slogan-ticker__button ecl-slogan-ticker__pause" data-ecl-slogan-ticker-pause>
        <span class="ecl-button__label" aria-hidden="true">{{ sr_pause|default('Pause') }}</span>
        {{ include('ecl5:icon', { name: 'pause-circle', family: 'phosphor', extra_classes: 'ecl-button__icon' }, false) }}
      </button>
    </div>
  </div>
{%- endapply -%}
