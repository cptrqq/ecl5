{{ attach_library('ecl5/global') }}
{%- apply spaceless -%}
  {%- set classes = [
    'ecl-text-input',
    width ? 'ecl-text-input--' ~ width,
    invalid ? 'ecl-text-input--invalid',
    extra_classes,
  ]|filter(c => c)|join(' ') -%}
  <input class="{{ classes }}" type="{{ type|default('text') }}"
    {{- id ? ' id="' ~ id|e('html_attr') ~ '"' -}}
    {{- name ? ' name="' ~ name|e('html_attr') ~ '"' -}}
    {{- value is defined and value is not null ? ' value="' ~ value|e('html_attr') ~ '"' -}}
    {{- placeholder ? ' placeholder="' ~ placeholder|e('html_attr') ~ '"' -}}
    {{- disabled ? ' disabled' -}}
    {{- required ? ' required' -}}
    {{- invalid ? ' aria-invalid="true"' -}}>
{%- endapply -%}
