{% stories ex_full_page with { title: 'ECL/Examples/Full page' } %}

  {% story header_content_and_footer with { name: 'Header, content and footer' } %}
    {{ include('ecl5:site-header', {
      site_name: 'Example site',
      logo: { src_desktop: 'https://placehold.co/160x80?text=Logo', alt: 'Logo', path: '#' },
      cta_link: { label: 'Subscribe', path: '#' },
      menu: { items: [ { label: 'Home', path: '#', is_current: true }, { label: 'Policies', path: '#' }, { label: 'News', path: '#' }, { label: 'Contact', path: '#' } ] }
    }) }}
    {{ include('ecl5:page-header', { title: 'Welcome', description: 'A full page composed from ECL components.', breadcrumb: { links: [ { label: 'Home', path: '#' }, { label: 'Welcome' } ] } }) }}
    <div class="ecl-container ecl-u-mv-l">
      {{ include('ecl5:text-media', { title: 'About this site', description: 'An example built entirely from ECL Single Directory Components.', link: { label: 'Learn more', path: '#' }, media_container: { picture: { img: { src: 'https://placehold.co/640x360', alt: 'Example image' } } } }) }}
    </div>
    {{ include('ecl5:site-footer', {
      section_common: { links: [ { label: 'About', path: '#' }, { label: 'Contact', path: '#' }, { label: 'Legal notice', path: '#' } ], links_inline: true }
    }) }}
  {% endstory %}

{% endstories %}
